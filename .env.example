# Environment variables template for local development
# Copy to .env for local work and set values

# Application
PORT=3000
APP_BASE_URL=http://localhost:5173
DATA_DIR=./data
OWNER_EMAIL=stella@stellahu.me
AUTH_MODE=password_totp

# Authentication
SESSION_SECRET=your-secret-key-here-change-this-in-production

# OpenRouter (LLM)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Token encryption (32-byte base64)
TOKEN_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Timezone
TIMEZONE=Australia/Melbourne

# S3 backups
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com
BACKUP_RETENTION_COUNT=30

# MCP (later milestone)
MCP_BEARER_TOKEN=your-mcp-bearer-token-here

# Honeycomb observability
HONEYCOMB_API_KEY=your-honeycomb-api-key-here
